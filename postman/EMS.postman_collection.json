{
  "info": {
    "name": "COMP3123 Assignment 2 \u2014 EMS API",
    "description": "Run folders 1\u20138 in the Collection Runner (set the working directory to this postman/ folder so fixtures/ resolve). Run folder 9 on its own with 11 iterations \u2014 it locks login for the rate-limit window.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 Health",
      "item": [
        {
          "name": "Health 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{healthUrl}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// unique users per run so the collection can be re-run",
                  "pm.environment.set('runId', Date.now().toString().slice(-6));",
                  "pm.environment.set('userA', 'alice_' + pm.environment.get('runId'));",
                  "pm.environment.set('userB', 'bob_' + pm.environment.get('runId'));"
                ]
              }
            }
          ]
        }
      ]
    },
