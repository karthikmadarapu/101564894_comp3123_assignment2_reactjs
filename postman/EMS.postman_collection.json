              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 or 429', () => pm.expect(pm.response.code).to.be.oneOf([401, 429]));",
                  "if (pm.info.iteration === pm.info.iterationCount - 1) {",
                  "  pm.test('last iteration is rate limited (429)', () => pm.response.to.have.status(429));",
                  "  pm.test('Retry-After header', () => pm.response.to.have.header('Retry-After'));",
                  "}"
                ]
              }
            }
          ]
        }
